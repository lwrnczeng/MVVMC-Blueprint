@startuml NavigationArchitecture
skinparam packageBackgroundColor #F8F9FA
skinparam packageBorderColor #4A90E2
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundCorner 8
skinparam class {
    BackgroundColor White
    ArrowColor #2C3E50
    BorderColor #2C3E50
}

header MVVM-C Navigation Architecture
title MVVM-C Navigation Architecture & Router Binding System

package "App / Root Orchestration Layer" #FAF0E6 {
    class AppContainerView << View >> {
        - appCoordinator: AppCoordinator
        + body: some View (TabView)
    }

    interface Coordinator {
        + childCoordinators: [Coordinator]
        + start()
        + addChild(coordinator: Coordinator)
        + removeChild(coordinator: Coordinator)
    }

    class AppCoordinator << @Observable, @MainActor >> {
        + childCoordinators: [Coordinator]
        + router: NavigationRouter
        + catalogCoordinator: CatalogCoordinator
        + checkoutCoordinator: CheckoutCoordinator
        + selectedTab: Tab
        + start()
        + catalogDidSelectProductForCheckout(product: Product)
    }

    enum "AppCoordinator.Tab" as AppTab {
        case catalog
        case checkout
    }
}

package "Core Navigation Engine" #F5EEF8 {
    class NavigationRouter << @Observable, @MainActor >> {
        + path: NavigationPath
        + push<T: Hashable>(route: T)
        + pop()
        + popToRoot()
    }

    note right of NavigationRouter
      **Centralized Navigation State**
      Wraps SwiftUI's NavigationPath.
      Coordinators push/pop routes programmatically.
      SwiftUI binds to '$coordinator.router.path'
      for native back-swipe & pop synchronization.
    end note
}

package "Catalog Feature (Module 1)" #EBF5FB {
    interface CatalogCoordinatorDelegate << AnyObject >> {
        + catalogDidSelectProductForCheckout(product: Product)
    }

    interface CatalogCoordinatorProtocol {
        + showProductDetail(product: Product)
        + proceedToCheckout(with product: Product)
    }

    enum CatalogRoute << Hashable, Sendable >> {
        case productList
        case productDetail(Product)
    }

    class CatalogCoordinator << @Observable, @MainActor >> {
        + childCoordinators: [Coordinator]
        + router: NavigationRouter
        + delegate: CatalogCoordinatorDelegate?
        - fetchProductsUseCase: FetchProductsUseCaseProtocol
        - catalogViewModel: CatalogViewModel
        + start()
        + showProductDetail(product: Product)
        + proceedToCheckout(with product: Product)
        + buildView(for route: CatalogRoute): some View
    }

    class CatalogContainerView << View >> {
        - coordinator: CatalogCoordinator
        + body: some View (NavigationStack)
    }

    class CatalogViewModel << @Observable, @MainActor >> {
        - coordinator: CatalogCoordinatorProtocol
        + selectProduct(product: Product)
    }

    class ProductListView << View >> {
        - viewModel: CatalogViewModel
    }

    class ProductDetailView << View >> {
        - product: Product
        - coordinator: CatalogCoordinatorProtocol
    }
}

package "Checkout Feature (Module 2)" #FDF2E9 {
    interface CheckoutCoordinatorProtocol {
        + showDiscount(for order: Order)
        + showPayment(for order: Order, discount: Discount?)
        + showSuccess(result: PaymentResult)
        + finishCheckout()
    }

    enum CheckoutRoute << Hashable, Sendable >> {
        case inputOrder
        case discount(Order)
        case payment(Order, Discount?)
        case success(PaymentResult)
    }

    class CheckoutCoordinator << @Observable, @MainActor >> {
        + childCoordinators: [Coordinator]
        + router: NavigationRouter
        - repository: OrderRepositoryProtocol
        - calculateDiscountUseCase: CalculateDiscountUseCaseProtocol
        - processPaymentUseCase: ProcessPaymentUseCaseProtocol
        + start()
        + showDiscount(for order: Order)
        + showPayment(for order: Order, discount: Discount?)
        + showSuccess(result: PaymentResult)
        + finishCheckout()
        + buildView(for route: CheckoutRoute): some View
    }

    class CheckoutContainerView << View >> {
        - coordinator: CheckoutCoordinator
        + body: some View (NavigationStack)
    }

    class CheckoutInputViewModel << @Observable, @MainActor >> {
        - coordinator: CheckoutCoordinatorProtocol
        + proceedToDiscount()
    }

    class DiscountViewModel << @Observable, @MainActor >> {
        - coordinator: CheckoutCoordinatorProtocol
        + skipOrProceedToPayment()
    }

    class PaymentViewModel << @Observable, @MainActor >> {
        - coordinator: CheckoutCoordinatorProtocol
        + processPayment()
    }

    class CheckoutInputView << View >> {
        - viewModel: CheckoutInputViewModel
    }

    class DiscountView << View >> {
        - viewModel: DiscountViewModel
    }

    class PaymentView << View >> {
        - viewModel: PaymentViewModel
    }

    class ReceiptView << View >> {
        - result: PaymentResult
        - onDone: () -> Void
    }
}

' Hierarchy & Conformance
Coordinator <|.. AppCoordinator
Coordinator <|.. CatalogCoordinator
Coordinator <|.. CheckoutCoordinator

CatalogCoordinatorProtocol <|.. CatalogCoordinator
CheckoutCoordinatorProtocol <|.. CheckoutCoordinator
CatalogCoordinatorDelegate <|.. AppCoordinator

' App Level Wiring
AppContainerView --> AppCoordinator : observes
AppCoordinator *-- CatalogCoordinator : owns child
AppCoordinator *-- CheckoutCoordinator : owns child
AppCoordinator --> AppTab : controls selectedTab
CatalogCoordinator --> CatalogCoordinatorDelegate : communicates via delegate

' Router Bindings
AppCoordinator --> NavigationRouter : has root router
CatalogCoordinator *-- NavigationRouter : owns dedicated router
CheckoutCoordinator *-- NavigationRouter : owns dedicated router

' Container View NavigationStack Bindings
CatalogContainerView --> CatalogCoordinator : observes
CatalogContainerView ..> NavigationRouter : binds '$coordinator.router.path' to NavigationStack
CheckoutContainerView --> CheckoutCoordinator : observes
CheckoutContainerView ..> NavigationRouter : binds '$coordinator.router.path' to NavigationStack

' Route & Factory Connections
CatalogCoordinator --> CatalogRoute : builds view for
CheckoutCoordinator --> CheckoutRoute : builds view for

' Catalog Presentation Wiring
CatalogContainerView ..> ProductListView : renders root
CatalogViewModel --> CatalogCoordinatorProtocol : invokes navigation
ProductListView --> CatalogViewModel : user events
ProductDetailView --> CatalogCoordinatorProtocol : invokes proceedToCheckout
CatalogCoordinator ..> ProductListView : builds
CatalogCoordinator ..> ProductDetailView : builds

' Checkout Presentation Wiring
CheckoutContainerView ..> CheckoutInputView : renders root
CheckoutInputViewModel --> CheckoutCoordinatorProtocol : invokes navigation
DiscountViewModel --> CheckoutCoordinatorProtocol : invokes navigation
PaymentViewModel --> CheckoutCoordinatorProtocol : invokes navigation
CheckoutCoordinator ..> CheckoutInputView : builds
CheckoutCoordinator ..> DiscountView : builds
CheckoutCoordinator ..> PaymentView : builds
CheckoutCoordinator ..> ReceiptView : builds

@enduml
